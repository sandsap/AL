# Copy to .env and fill in. The demo runs with NONE of these set (mock mode).

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ASR (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-phonecall

# --- TTS (Cartesia) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
CARTESIA_VERSION=2024-11-13

# --- CRM (Housecall Pro) ---
HOUSECALL_PRO_API_KEY=
HOUSECALL_PRO_BASE_URL=https://api.housecallpro.com

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Data (set for production; demo needs none) ---
DATABASE_URL=
REDIS_URL=

# --- Servers ---
PORT=8080
MEDIA_PORT=8081
