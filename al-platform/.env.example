# Copy to .env and fill in. The demo runs with NONE of these set (mock mode).

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Fast/cheap model for simple turns (two-tier routing in the media gateway).
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ASR (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-phonecall

# --- TTS (Cartesia) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2
CARTESIA_VERSION=2024-11-13

# --- CRM (Housecall Pro) ---
HOUSECALL_PRO_API_KEY=
HOUSECALL_PRO_BASE_URL=https://api.housecallpro.com

# --- CRM (Jobber) ---
JOBBER_ACCESS_TOKEN=
JOBBER_API_VERSION=2023-11-15
JOBBER_ENDPOINT=https://api.getjobber.com/api/graphql
JOBBER_OPEN_HOUR=8
JOBBER_CLOSE_HOUR=18

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Data (set for production; demo needs none) ---
DATABASE_URL=
REDIS_URL=

# --- Servers ---
PORT=8080
MEDIA_PORT=8081
